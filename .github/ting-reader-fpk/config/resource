{
    "docker-project": {
        "projects": [
            {
                "name": "ting-reader-docker",
                "path": "docker"
            }
        ]
    },
    "api-scope": [
        "trim.system.getPlatformConfig"
    ],
    "data-share": {
        "shares": [
            {
                "name": "ting-reader-docker/data",
                "permission": {
                    "rw": [
                        "ting-reader-docker"
                    ]
                }
            },
            {
                "name": "ting-reader-docker/storage",
                "permission": {
                    "rw": [
                        "ting-reader-docker"
                    ]
                }
            },
            {
                "name": "ting-reader-docker/plugins",
                "permission": {
                    "rw": [
                        "ting-reader-docker"
                    ]
                }
            },
            {
                "name": "ting-reader-docker/temp",
                "permission": {
                    "rw": [
                        "ting-reader-docker"
                    ]
                }
            }
        ]
    },
    "authorization-path": [
        {
            "field": "wizard_storage_path",
            "description": "有声书存储目录",
            "permission": "rw"
        }
    ]
}
